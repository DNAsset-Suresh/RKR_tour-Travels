NODE_ENV=development
HOST=127.0.0.1
PORT=5000
FRONTEND_ORIGIN=http://localhost:3001,http://localhost:3002

# MongoDB Atlas Database Connection
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@rkr.ei9mzh3.mongodb.net/travels?retryWrites=true&w=majority

PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=rkr_tour
PGUSER=rkr_app
PGPASSWORD=replace-with-a-strong-password
PGSSL=false
