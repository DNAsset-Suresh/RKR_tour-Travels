# Retained only for the unused legacy Mapbox modules; the active planner uses Google.
MAPBOX_PUBLIC_TOKEN=
MAPBOX_SERVER_TOKEN=

# Inactive legacy provider integration. Not required or used by the current calculator.
GOOGLE_MAPS_API_KEY=
# Inactive legacy AI settings; the current calculator uses deterministic summaries.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Key-free routing. Optional endpoint overrides for self-hosted compatible services.
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://routing.openstreetmap.de/routed-car
# Identify the deployed application and a real contact URL when publishing.
OPEN_ROUTING_USER_AGENT=RKR-Tour/1.0 (local travel-planning website; http://localhost:3002)
