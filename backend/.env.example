NODE_ENV=development
HOST=127.0.0.1
PORT=5000
FRONTEND_ORIGIN=http://localhost:3001,http://localhost:3002

# MongoDB Atlas Database Connection
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@rkr.ei9mzh3.mongodb.net/travels?retryWrites=true&w=majority

# Local PostgreSQL Fallback
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=rkr_tour
PGUSER=rkr_app
PGPASSWORD=replace-with-a-strong-password
PGSSL=false
ADMIN_API_KEY=replace-with-at-least-32-random-characters

# Business Profile & Contact Info
BUSINESS_PHONE=9629426655
BUSINESS_WHATSAPP=9629426655
BUSINESS_EMAIL=travel.rkr@gmail.com
BUSINESS_ADDRESS="23/2 Madipakkam Main Road, Kaiveli, Pallikarani, Chennai, TamilNadu PIN 600100"
